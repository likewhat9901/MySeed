# Notion Public integration OAuth — 로컬 데모 (backend notion_oauth_demo 라우트)
# 이 파일 이름을 그대로 .env 에 붙여 쓰지 말고, 값만 backend/.env 로 옮겨 두세요.

NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# 노션 포털 Redirect URIs 와 문자 단위 동일 (예시 — 실제 실행 포트에 맞게 수정)
NOTION_OAUTH_REDIRECT_URI=http://localhost:8000/api/notion/oauth-demo/callback

# 동의 후 브라우저를 돌려보낼 프론트 URL (기본값은 코드 내 localhost:3000)
NOTION_OAUTH_FRONTEND_RESULT_URL=http://localhost:3000/dev/notion-oauth/result

# 프론트 .env.local
# NEXT_PUBLIC_MYSEED_API_URL=http://localhost:8000
